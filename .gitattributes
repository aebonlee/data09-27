# Windows 에서 돌리는 파일은 CRLF 로 (메모장·PowerShell 5.1 · cmd 가 줄바꿈을 제대로 읽게)
*.ps1 text eol=crlf
*.bat text eol=crlf
collector/*.txt text eol=crlf
